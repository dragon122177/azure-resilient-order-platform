{
  "Infrastructure": {
    "DatabaseProvider": "Sqlite",
    "DatabaseConnectionString": "Data Source=../../ordergrid.db",
    "InitializeDatabase": true,
    "SeedDemoData": true,
    "MessagingMode": "Local",
    "ServiceBusTopic": "order-events",
    "ServiceBusSubscription": "orchestrator",
    "ServiceBusAnalyticsSubscription": "analytics",
    "StorageMode": "Local",
    "LocalStoragePath": "./artifacts/receipts",
    "ReceiptContainer": "order-receipts"
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } }
}
